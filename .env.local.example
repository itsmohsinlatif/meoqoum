# ── Cloudinary ────────────────────────────────────────────────────────────────
# Sign up free at https://cloudinary.com — copy your "Cloud name" from the dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Create an UNSIGNED upload preset:
#   Cloudinary Dashboard → Settings → Upload → Add upload preset
#   Signing mode = Unsigned  |  Folder = meoqoum
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=meoqoum_unsigned

# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Settings → API → Project URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — KEEP SECRET, never expose to browser
# Settings → API → service_role (secret) key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# The email address that gets admin access to /admin panel
# Must match a real Supabase Auth user (i.e. sign up with this email first)
ADMIN_EMAIL=itsmohsinlatif@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=itsmohsinlatif@gmail.com

# ════════════════════════════════════════════════════════════════════════════════
# DATABASE SCHEMA — run this once in the Supabase SQL Editor
# ════════════════════════════════════════════════════════════════════════════════
#
# -- ── Extensions ─────────────────────────────────────────────────────────────
# CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
#
# -- ── Pals (13 clans) ─────────────────────────────────────────────────────────
# CREATE TABLE pals (
#   id       smallserial PRIMARY KEY,
#   slug     text UNIQUE NOT NULL,
#   name_en  text NOT NULL,
#   name_ur  text NOT NULL,
#   vansh    text
# );
#
# -- ── Gotras (52 sub-clans) ───────────────────────────────────────────────────
# CREATE TABLE gotras (
#   id       smallserial PRIMARY KEY,
#   pal_id   smallint REFERENCES pals(id),
#   slug     text UNIQUE NOT NULL,
#   name_en  text NOT NULL,
#   name_ur  text NOT NULL
# );
#
# -- ── Core member profiles (linked to Supabase Auth) ─────────────────────────
# CREATE TABLE profiles (
#   id               uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
#   first_name       text NOT NULL,
#   last_name        text NOT NULL,
#   father_name      text NOT NULL,
#   date_of_birth    date NOT NULL,
#   gender           text NOT NULL CHECK (gender IN ('male','female')),
#   pal_id           smallint REFERENCES pals(id),
#   gotra_id         smallint REFERENCES gotras(id),
#   pichla_gaoon     text,
#   marital_status   text NOT NULL DEFAULT 'unmarried'
#     CHECK (marital_status IN ('unmarried','married','divorced','widowed','other')),
#   blood_group      text
#     CHECK (blood_group IN ('A+','A-','B+','B-','AB+','AB-','O+','O-','Unknown')),
#   religion         text NOT NULL DEFAULT 'Islam',
#   education_level  text
#     CHECK (education_level IN ('none','primary','secondary','intermediate',
#                                'bachelor','master','phd','other')),
#   education_field  text,
#   profession       text,
#   cnic_no          text UNIQUE,
#   permanent_addr   text,
#   current_addr     text,
#   country          text,
#   state_province   text,
#   district         text,
#   city             text,
#   contact_no       text,
#   profile_pic_id   text,        -- Cloudinary public_id
#   is_verified      boolean NOT NULL DEFAULT false,
#   is_active        boolean NOT NULL DEFAULT true,
#   created_at       timestamptz NOT NULL DEFAULT now(),
#   updated_at       timestamptz NOT NULL DEFAULT now()
# );
#
# -- ── Marriage / Rishta profiles ──────────────────────────────────────────────
# CREATE TABLE marriage_profiles (
#   id                 uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#   user_id            uuid UNIQUE NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
#   degree_doc_id      text,       -- Cloudinary public_id
#   degree_type        text,       -- e.g. "MBBS", "BA", "BSc Engineering"
#   is_degree_verified boolean NOT NULL DEFAULT false,
#   bio                text,
#   height_cm          smallint CHECK (height_cm BETWEEN 100 AND 250),
#   weight_kg          smallint,
#   complexion         text CHECK (complexion IN ('fair','medium','olive','dark')),
#   pref_age_min       smallint DEFAULT 18 CHECK (pref_age_min >= 18),
#   pref_age_max       smallint DEFAULT 50 CHECK (pref_age_max <= 80),
#   pref_education     text,
#   pref_country       text,
#   pref_notes         text,
#   is_active          boolean NOT NULL DEFAULT true,
#   created_at         timestamptz NOT NULL DEFAULT now(),
#   updated_at         timestamptz NOT NULL DEFAULT now()
# );
#
# -- ── Auto-update timestamp ────────────────────────────────────────────────────
# CREATE OR REPLACE FUNCTION update_updated_at()
# RETURNS TRIGGER LANGUAGE plpgsql AS $$
# BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;
#
# CREATE TRIGGER profiles_ts
#   BEFORE UPDATE ON profiles FOR EACH ROW EXECUTE FUNCTION update_updated_at();
# CREATE TRIGGER marriage_ts
#   BEFORE UPDATE ON marriage_profiles FOR EACH ROW EXECUTE FUNCTION update_updated_at();
#
# -- ── Row Level Security ───────────────────────────────────────────────────────
# ALTER TABLE profiles          ENABLE ROW LEVEL SECURITY;
# ALTER TABLE marriage_profiles ENABLE ROW LEVEL SECURITY;
# ALTER TABLE pals              ENABLE ROW LEVEL SECURITY;
# ALTER TABLE gotras            ENABLE ROW LEVEL SECURITY;
#
# -- Reference tables: public read
# CREATE POLICY "public read pals"   ON pals   FOR SELECT USING (true);
# CREATE POLICY "public read gotras" ON gotras FOR SELECT USING (true);
#
# -- Profiles: own full access; other authenticated members read non-sensitive cols
# CREATE POLICY "own profile full"   ON profiles FOR ALL    USING (auth.uid() = id);
# CREATE POLICY "members read profiles" ON profiles FOR SELECT
#   USING (auth.role() = 'authenticated' AND is_active = true);
#
# -- Marriage profiles: own full access; members read active listings
# CREATE POLICY "own marriage"       ON marriage_profiles FOR ALL
#   USING (auth.uid() = user_id);
# CREATE POLICY "members read rishta" ON marriage_profiles FOR SELECT
#   USING (auth.role() = 'authenticated' AND is_active = true);
